package com.example.demo.feature.evaluation.service;

import com.example.demo.common.ApiResponse;
import com.example.demo.feature.evaluation.domain.Evaluation;
import com.example.demo.feature.evaluation.domain.Evaluation.Category;
import com.example.demo.feature.evaluation.domain.Evaluation.Status;
import com.example.demo.feature.evaluation.mapper.EvaluationMapper;
import com.example.demo.feature.evaluation.repository.EvaluationRepository;
import com.example.demo.feature.evaluation.dto.EvaluationDto;
import lombok.RequiredArgsConstructor;
import org.springframework.data.domain.Page;
import org.springframework.data.domain.PageRequest;
import org.springframework.data.domain.Pageable;
import org.springframework.data.domain.Sort;
import org.springframework.stereotype.Service;

import java.time.LocalDateTime;
import java.util.List;
import java.util.Map;
import java.util.Optional;

@Service
@RequiredArgsConstructor
public class EvaluationService {
    private final EvaluationRepository evaluationRepository;
    private final EvaluationMapper evaluationMapper;

    public ApiResponse<Page<EvaluationDto.Response>> getEvaluations(
        Integer page, Integer limit, String sort, String category, String status,
        String evaluator, String evaluatee, Integer minScore, Integer maxScore) {
        
        Pageable pageable = PageRequest.of(
            page != null ? page - 1 : 0,
            limit != null ? limit : 10,
            sort != null ? Sort.by(sort) : Sort.by("createdAt").descending()
        );

        Page<Evaluation> evaluationPage = evaluationRepository.findWithFilters(
            category, status, evaluator, evaluatee, minScore, maxScore, pageable
        );

        return ApiResponse.success()
            .withData(evaluationMapper.toPageResponse(evaluationPage))
            .withMeta(Map.of(
                "total", evaluationPage.getTotalElements(),
                "page", evaluationPage.getNumber() + 1,
                "pages", evaluationPage.getTotalPages()
            ));
    }

    public ApiResponse<EvaluationDto.Response> getEvaluation(String id) {
        return evaluationRepository.findByIdWithDetails(id)
            .map(evaluation -> ApiResponse.success().withData(evaluationMapper.toResponse(evaluation)))
            .orElse(ApiResponse.notFound("평가 데이터를 찾을 수 없습니다"));
    }

    public ApiResponse<EvaluationDto.Response> createEvaluation(EvaluationDto.Request request) {
        Evaluation evaluation = evaluationMapper.toEntity(request);
        Evaluation saved = evaluationRepository.save(evaluation);
        return ApiResponse.created().withData(evaluationMapper.toResponse(saved));
    }

    public ApiResponse<EvaluationDto.Response> updateEvaluation(String id, EvaluationDto.Request request) {
        return evaluationRepository.findById(id)
            .map(existing -> {
                Evaluation updated = evaluationMapper.updateEntity(existing, request);
                Evaluation saved = evaluationRepository.save(updated);
                return ApiResponse.success().withData(evaluationMapper.toResponse(saved));
            })
            .orElse(ApiResponse.notFound("평가 데이터를 찾을 수 없습니다"));
    }

    public ApiResponse<Void> deleteEvaluation(String id) {
        return evaluationRepository.findById(id)
            .map(evaluation -> {
                evaluationRepository.delete(evaluation);
                return ApiResponse.success().withMessage("평가 데이터가 삭제되었습니다");
            })
            .orElse(ApiResponse.notFound("평가 데이터를 찾을 수 없습니다"));
    }

    public ApiResponse<EvaluationDto.StatsResponse> getStats() {
        List<Object[]> categoryStats = evaluationRepository.getStatsByCategory();
        Double overallAvg = evaluationRepository.getOverallAverageScore();
        List<Object[]> statusStats = evaluationRepository.getStatsByStatus();

        return ApiResponse.success().withData(new EvaluationDto.StatsResponse(
            categoryStats.stream().map(arr -> new EvaluationDto.CategoryStat(
                (String) arr[0],
                (Double) arr[1],
                (Long) arr[2],
                (Integer) arr[3],
                (Integer) arr[4]
            )).toList(),
            overallAvg != null ? overallAvg : 0.0,
            statusStats.stream().map(arr -> new EvaluationDto.StatusStat(
                (String) arr[0],
                (Long) arr[1]
            )).toList()
        ));
    }
}

