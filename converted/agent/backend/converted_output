package com.example.demo.feature.evaluation.repository;

import com.example.demo.feature.evaluation.domain.Evaluation;
import org.springframework.data.domain.Page;
import org.springframework.data.domain.Pageable;
import org.springframework.data.jpa.repository.JpaRepository;
import org.springframework.data.jpa.repository.Query;
import org.springframework.data.repository.query.Param;

import java.util.List;
import java.util.Optional;

public interface EvaluationRepository extends JpaRepository<Evaluation, String> {
    @Query("SELECT e FROM Evaluation e WHERE " +
           "(:category IS NULL OR e.category = :category) AND " +
           "(:status IS NULL OR e.status = :status) AND " +
           "(:evaluator IS NULL OR LOWER(e.evaluator) LIKE LOWER(CONCAT('%', :evaluator, '%'))) AND " +
           "(:evaluatee IS NULL OR LOWER(e.evaluatee) LIKE LOWER(CONCAT('%', :evaluatee, '%'))) AND " +
           "(:minScore IS NULL OR e.score >= :minScore) AND " +
           "(:maxScore IS NULL OR e.score <= :maxScore)")
    Page<Evaluation> findWithFilters(
        @Param("category") String category,
        @Param("status") String status,
        @Param("evaluator") String evaluator,
        @Param("evaluatee") String evaluatee,
        @Param("minScore") Integer minScore,
        @Param("maxScore") Integer maxScore,
        Pageable pageable
    );

    @Query("SELECT e FROM Evaluation e WHERE e.id = :id")
    Optional<Evaluation> findByIdWithDetails(@Param("id") String id);

    @Query(value = "SELECT e.category as _id, " +
                   "AVG(e.score) as avgScore, " +
                   "COUNT(e) as count, " +
                   "MIN(e.score) as minScore, " +
                   "MAX(e.score) as maxScore " +
                   "FROM Evaluation e " +
                   "GROUP BY e.category " +
                   "ORDER BY avgScore DESC")
    List<Object[]> getStatsByCategory();

    @Query("SELECT AVG(e.score) FROM Evaluation e")
    Double getOverallAverageScore();

    @Query("SELECT e.status as _id, COUNT(e) as count FROM Evaluation e GROUP BY e.status")
    List<Object[]> getStatsByStatus();
}

