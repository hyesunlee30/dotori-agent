    @Mappings({
        @Mapping(target = "id", source = "id"),
        @Mapping(target = "title", source = "title"),
        @Mapping(target = "evaluator", source = "evaluator"),
        @Mapping(target = "evaluatee", source = "evaluatee"),
        @Mapping(target = "category", source = "category"),
